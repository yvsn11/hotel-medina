# Copy to .env and edit. Never commit .env.
# Every value below is a placeholder, not a real secret.
# `docker compose up --build` works without a .env: compose has its own defaults.

# --- API -------------------------------------------------------------------

# Database used by the API when run on the host (compose overrides this to point at the `db` service).
# Plain postgresql:// and postgres:// URLs (Neon, Render, Supabase) are normalized to psycopg 3.
DATABASE_URL=postgresql+psycopg://medina:medina@localhost:5433/medina

# Database used by pytest. Must be a separate, disposable database.
# With `make test-db` this is created inside the compose Postgres (host port 5433).
TEST_DATABASE_URL=postgresql+psycopg://medina:medina@127.0.0.1:5433/medina_test

# Required in production. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-dev-only

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Minutes an unpaid PENDING booking holds a room.
HOLD_MINUTES=15

# Tourist tax in MAD per person per night (illustrative, configurable).
TOURIST_TAX_PER_PERSON_NIGHT=15.00

# --- Payments --------------------------------------------------------------

# `mock` or `stripe`. Defaults to stripe when STRIPE_SECRET_KEY is set, otherwise mock.
PAYMENT_PROVIDER=mock

# Stripe test-mode keys (leave empty to use the mock provider).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Frontend (read at build time by Vite) ----------------------------------

# Empty in local dev: Vite proxies /api to http://localhost:5000.
# docker compose sets it to http://localhost:5000 for the web image.
# In production, set it to the API origin, e.g. https://<your-api>.onrender.com
VITE_API_URL=

# Stripe publishable test key (pk_test_...). Leave empty to use the mock payment flow.
VITE_STRIPE_PUBLISHABLE_KEY=
